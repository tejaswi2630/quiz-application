  void startQuiz(String category) {
    List<Question> questions;

    if (category == 'My Questions') {
      questions = List.from(customQuestions);
    } else {
      questions = List.from(quizzes[category] ?? []);
    }

    if (questions.isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('Please add questions first!'),
        ),
      );
      return;
    }

    Navigator.push(
      context,
      MaterialPageRoute(
        builder: (_) => QuizScreen(
          category: category,
          questions: questions,
          onFinish: (score) {
            setState(() {
              if (score > (bestScores[category] ?? 0)) {
                bestScores[category] = score;
              }
            });
          },
        ),
      ),
    );
  }

  void addQuestion() {
    final questionController = TextEditingController();
    final answerController = TextEditingController();
    final option2Controller = TextEditingController();
    final option3Controller = TextEditingController();
    final option4Controller = TextEditingController();

    showDialog(
      context: context,
      builder: (dialogContext) {
        return AlertDialog(
          title: const Text('Add New Question'),
          content: SingleChildScrollView(
            child: Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                TextField(
                  controller: questionController,
                  decoration: const InputDecoration(
                    labelText: 'Question',
                  ),
